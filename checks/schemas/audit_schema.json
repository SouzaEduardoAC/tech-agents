{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditReportSchema",
  "type": "object",
  "required": [
    "target_scope",
    "regulations_evaluated",
    "threat_surface",
    "findings",
    "overall_verdict"
  ],
  "properties": {
    "target_scope": { "type": "string", "minLength": 5 },
    "regulations_evaluated": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "threat_surface": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "description", "remediation"],
        "properties": {
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "overall_verdict": {
      "type": "string",
      "enum": ["PASSED", "PASSED_WITH_CONDITIONS", "REJECTED"]
    }
  }
}
